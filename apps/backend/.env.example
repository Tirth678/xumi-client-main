DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_BASE_URL=https://your-auth-host/neondb/auth
NEON_AUTH_JWKS_URL=https://your-auth-host/neondb/auth/.well-known/jwks.json
WEB_ORIGIN=http://localhost:5173
GMAIL_USER=your-account@gmail.com
# Google App Password (requires 2-Step Verification), not your account password.
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional; defaults to RoboCraft <GMAIL_USER>. Use your account or a configured Gmail alias.
# EMAIL_FROM=RoboCraft <your-account@gmail.com>
# EMAIL_REPLY_TO=support@your-domain.com
ADMIN_EMAIL=orders@your-domain.com
ADMIN_API_KEY=generate-a-long-random-secret
PAYMENT_URL=https://your-payment-provider.example/checkout
PORT=3001
